<Window x:Class="MediaSavodxonlik.AdminPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaLab · Materiallarni boshqarish" Width="980" Height="680" MinWidth="760" MinHeight="510"
        WindowStartupLocation="CenterOwner" Background="#0E1828" Foreground="#F1F5F9" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#101C2C"/><Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="BorderBrush" Value="#3C5367"/><Setter Property="CaretBrush" Value="#5EEAD4"/>
   <Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/>
  </Style>
  <Style TargetType="ListBoxItem" x:Key="AdminChoice">
   <Setter Property="Foreground" Value="#DBE8F4"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
              CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B3045"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#20423F"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="Yopish" Click="ClosePanel" IsCancel="True" BorderBrush="#3C5367" BorderThickness="1" VerticalAlignment="Center"/>
   <TextBlock Text="Mavzu va materiallar" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Background="#152438" CornerRadius="12" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="Mavzu nomi yoki raqami" Foreground="#BACBDD" Margin="0,0,0,6"/>
     <TextBox x:Name="TopicSearch" Grid.Row="1" TextChanged="SearchTopics" AutomationProperties.Name="Mavzuni qidirish"/>
     <ListBox x:Name="Topics" Grid.Row="2" SelectionChanged="ChooseTopic" ItemContainerStyle="{StaticResource AdminChoice}"
              Background="Transparent" BorderThickness="0" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              AutomationProperties.Name="Mavzular">
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding Label}" Foreground="#5EEAD4" FontSize="10"/>
       <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3,0,0"/>
       <TextBlock Text="{Binding Schedule}" Foreground="#BACBDD" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="NoTopics" Grid.Row="2" Text="Mavzu topilmadi." Visibility="Collapsed" Foreground="#BACBDD" Margin="10,20"/>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#152438" CornerRadius="12" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="Editor">
      <TextBlock x:Name="SelectedTopicLabel" Foreground="#5EEAD4" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock Text="Mavzu nomi" Margin="0,10,0,6"/>
      <TextBox x:Name="TopicName" MaxLength="200" TextWrapping="Wrap" TextChanged="EditName" AutomationProperties.Name="Mavzu nomi"/>
      <Button x:Name="SaveButton" Content="Nomni saqlash" Click="SaveTopic" Background="#214744" Foreground="#99F6E4"
              HorizontalAlignment="Left" Margin="0,8,0,16" Padding="12,8"/>
      <TextBlock Text="Materiallar" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ListBox x:Name="ResourceType" SelectionChanged="ChooseResource" Background="#101C2C" BorderThickness="0"
               ItemContainerStyle="{StaticResource AdminChoice}" AutomationProperties.Name="Material turi">
       <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBoxItem Content="Ma’ruza" Tag="lecture"/><ListBoxItem Content="Media" Tag="media"/><ListBoxItem Content="Taqdimot" Tag="slides"/>
      </ListBox>
      <TextBlock x:Name="Formats" Foreground="#BACBDD" TextWrapping="Wrap" Margin="0,8,0,10"/>
      <TextBlock x:Name="Destination" Foreground="#BACBDD" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Button x:Name="ImportButton" Content="＋  Fayllarni yuklash" Click="ImportFile" Background="#2DD4BF" Foreground="#082C30"
              HorizontalAlignment="Left" Padding="12,8"/>
      <TextBlock x:Name="FileCount" Foreground="#BACBDD" Margin="0,14,0,6"/>
      <ItemsControl x:Name="Files"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#101C2C" CornerRadius="8" Padding="10" Margin="0,0,0,6">
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="O‘chirish" Tag="{Binding}" Click="DeleteFile"
                 AutomationProperties.Name="{Binding StringFormat=O‘chirish · {0}}"
                 Foreground="#FDA4AF" BorderBrush="#744355" BorderThickness="1" Padding="9,6" Margin="10,0,0,0"/>
         <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Mavzu glossariysi" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,6"/>
      <TextBlock Text="Har qatorda «Atama — izoh» shaklida yozing." Foreground="#BACBDD" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBox x:Name="GlossaryEditor" MinHeight="100" MaxHeight="240" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" TextChanged="EditGlossary" AutomationProperties.Name="Mavzu glossariysi"/>
      <Button x:Name="SaveGlossaryButton" Content="Glossariyni saqlash" Click="SaveGlossary" Background="#214744"
              Foreground="#99F6E4" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,8"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="2" Foreground="#99F6E4" TextWrapping="Wrap" MinHeight="20" Margin="0,12,0,0"
             AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
