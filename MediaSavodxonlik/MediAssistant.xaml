<UserControl x:Class="MediaSavodxonlik.MediAssistant" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MediaSavodxonlik" Foreground="#F1F5F9" FontFamily="Segoe UI">
 <StackPanel>
  <local:MediChat x:Name="Chat" Width="370" Visibility="Collapsed" Margin="0,0,0,10"/>
  <Grid x:Name="Bubble">
   <Grid.Width>320</Grid.Width>
   <Border Background="#182B40" BorderBrush="#3A726F" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,12">
    <StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="Dismiss" Padding="6,0" FontSize="20" Foreground="#93A4BA" AutomationProperties.Name="Medi izohini yopish"/><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#2DD4BF" Margin="0,0,7,0"/><TextBlock Text="MEDI · DASTUR YO‘LBOSHCHISI" FontSize="9" Foreground="#5EEAD4" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></DockPanel>
     <TextBlock x:Name="Heading" Text="Salom! Men Medi — yordamchingizman." FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"/>
     <TextBlock x:Name="Explanation" Text="Dasturdan qanday foydalanishni ko‘rsatib beraymi?" FontSize="13" Foreground="#BAC8D9" TextWrapping="Wrap" LineHeight="21"/>
     <Border x:Name="ProgressArea" Visibility="Collapsed" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="StepLabel" FontSize="10" Foreground="#93A4BA" Margin="0,0,0,8"/><ProgressBar x:Name="TourProgress" Minimum="0" Maximum="6" Height="3" Foreground="#2DD4BF" Background="#2D4258" BorderThickness="0"/></StackPanel></Border>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PrimaryButton" Content="Ha, ko‘rsating" Background="#2DD4BF" Foreground="#082C30" FontWeight="SemiBold" Padding="13,10" Click="Primary" HorizontalContentAlignment="Center"/><Button x:Name="SecondaryButton" Grid.Column="1" Content="Keyinroq" Foreground="#93A4BA" FontSize="12" Margin="8,0,0,0" Padding="9,10" Click="Secondary"/></Grid>
    </StackPanel>
   </Border>
   <Path Data="M 264,0 L 280,0 L 272,12 Z" Fill="#182B40" Stroke="#3A726F" StrokeThickness="1" Width="18" Height="13" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,0"/>
  </Grid>
  <Button Click="RobotClick" Padding="0" HorizontalAlignment="Right" ToolTip="Medi — foydalanish yo‘riqnomasini ochish" AutomationProperties.Name="Medi yordamchisini ochish">
   <StackPanel><Grid x:Name="RobotBody" Width="112" Height="112" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <Ellipse Width="62" Height="8" Fill="#23394A" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
    <Canvas Width="112" Height="106">
     <Line X1="55" Y1="17" X2="55" Y2="8" Stroke="#76E4D7" StrokeThickness="3"/><Ellipse Canvas.Left="51" Canvas.Top="1" Width="9" Height="9" Fill="#A78BFA"/>
     <Border Canvas.Left="29" Canvas.Top="65" Width="53" Height="31" CornerRadius="11" BorderBrush="#77E6D7" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#67E8D4"/><GradientStop Color="#1DAA9E" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="m." Foreground="#0C4447" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border Canvas.Left="18" Canvas.Top="22" Width="10" Height="23" CornerRadius="5" Background="#2DB9AC"/><Border Canvas.Left="83" Canvas.Top="22" Width="10" Height="23" CornerRadius="5" Background="#2DB9AC"/>
     <Border Canvas.Left="23" Canvas.Top="16" Width="65" Height="53" CornerRadius="18" BorderBrush="#A1F4E5" BorderThickness="1.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8AF1DD"/><GradientStop Color="#2DD4BF" Offset="1"/></LinearGradientBrush></Border.Background><Border Background="#102A3C" CornerRadius="13" Margin="6,7,6,9"><Canvas><Border x:Name="LeftEye" Canvas.Left="10" Canvas.Top="8" Width="7" Height="10" CornerRadius="3" Background="#83F6DE" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border><Border x:Name="RightEye" Canvas.Left="31" Canvas.Top="8" Width="7" Height="10" CornerRadius="3" Background="#83F6DE" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border><Path Data="M 19,23 Q 24,28 29,23" Stroke="#83F6DE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Border></Border>
     <Border Canvas.Left="18" Canvas.Top="70" Width="9" Height="20" Background="#49D3BE" CornerRadius="4" RenderTransformOrigin="0.5,0"><Border.RenderTransform><RotateTransform Angle="15"/></Border.RenderTransform></Border>
     <Ellipse Canvas.Left="79" Canvas.Top="70" Width="10" Height="10" Fill="#6FE9D1"/>
     <Grid x:Name="WaveArm" Canvas.Left="79" Canvas.Top="71" Width="10" Height="25" RenderTransformOrigin="0.5,0.16"><Grid.RenderTransform><RotateTransform Angle="-135"/></Grid.RenderTransform><Border Background="#6FE9D1" CornerRadius="5"/><Border Background="#A5F3E1" Height="8" CornerRadius="4" VerticalAlignment="Bottom"/></Grid>
     <Border Canvas.Left="34" Canvas.Top="93" Width="17" Height="7" CornerRadius="3" Background="#77DEC9"/><Border Canvas.Left="61" Canvas.Top="93" Width="17" Height="7" CornerRadius="3" Background="#77DEC9"/>
    </Canvas>
   </Grid><Border Background="#183C40" BorderBrush="#306763" BorderThickness="1" CornerRadius="9" Padding="12,4" HorizontalAlignment="Center"><TextBlock Text="MEDI" Foreground="#99F6E4" FontSize="9" FontWeight="Bold"/></Border></StackPanel>
  </Button>
 </StackPanel>
</UserControl>
