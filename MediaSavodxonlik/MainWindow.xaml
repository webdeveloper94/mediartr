      <TextBlock Text="Mavzuni o‘rganish" FontSize="22" FontWeight="SemiBold" Margin="0,25,0,6"/>
      <TextBlock Text="Kerakli resursni tanlang — barchasi bir joyda." Foreground="#93A4BA" FontSize="12" Margin="0,0,0,18"/>
      <Button x:Name="TopicIndependent" Click="OpenTopicIndependent" Content="Mustaqil ish · 1 soat →"
              Visibility="Collapsed" HorizontalAlignment="Left" Background="#214744" Foreground="#99F6E4" Margin="0,0,0,12"/>
      <ItemsControl x:Name="TopicResources">
       <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><EventSetter Event="Loaded" Handler="ResourceCardLoaded"/></Style></ItemsControl.ItemContainerStyle>
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Tag="{Binding Key}" Click="OpenResource" MouseEnter="TopicHover" MouseLeave="TopicLeave" GotKeyboardFocus="TopicHover" LostKeyboardFocus="TopicLeave" Background="#131F32" BorderBrush="#2C3C54" BorderThickness="1" Padding="14,18" Margin="0,0,8,8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
         <StackPanel>
          <Border CornerRadius="11" Padding="10">
           <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#162338"/><GradientStop Color="{Binding Surface}" Offset="1"/></LinearGradientBrush></Border.Background>
           <DockPanel>
            <Border DockPanel.Dock="Left" Background="#66101A29" CornerRadius="10" Width="46" Height="46" Margin="0,0,10,0">
             <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Color}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="↗" Foreground="{Binding Color}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
           </DockPanel>
          </Border>
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,5"/>
          <TextBlock Text="{Binding Description}" Foreground="#D1DFEC" FontSize="14" TextWrapping="Wrap"/>
          <Border Height="1" Background="#31445C" Margin="0,12,0,10"/>
          <TextBlock Text="Resursni ochish →" Foreground="{Binding Color}" FontSize="12" FontWeight="SemiBold"/>
         </StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <StackPanel x:Name="ResourcePage" Visibility="Collapsed">
      <Button Click="ReturnToTopic" Foreground="#5EEAD4" Padding="0,8" Content="←  Mavzu resurslariga qaytish" HorizontalAlignment="Left" Margin="0,0,0,18"/>
      <Border BorderBrush="#36566A" BorderThickness="1" CornerRadius="18" Padding="26">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#15383D"/><GradientStop Color="#22243C" Offset="1"/></LinearGradientBrush></Border.Background>
       <StackPanel>
        <DockPanel>
         <Border DockPanel.Dock="Right" Background="#233148" CornerRadius="6" Padding="10,6"><TextBlock x:Name="ResourceMode" FontSize="9" Foreground="#99F6E4"/></Border>
         <Button x:Name="AskAiButton" DockPanel.Dock="Right" Click="AskAiAboutTopic" Margin="0,0,10,0" Padding="10,4" Background="#1D3E42" BorderBrush="#39857E" BorderThickness="1" Foreground="#99F6E4" FontSize="11" FontWeight="SemiBold" Content="🤖  AI Yordamchidan so‘rash"/>
         <TextBlock x:Name="ResourceStatus" Foreground="#93A4BA" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,12"><TextBlock x:Name="ResourceIcon" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#5EEAD4" Margin="0,0,14,0"/><TextBlock x:Name="ResourceTitle" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <TextBlock x:Name="ResourceDescription" FontSize="15" Foreground="#BAC8D9" TextWrapping="Wrap" LineHeight="23"/>
       </StackPanel>
      </Border>
      <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Foreground="#5EEAD4" Margin="0,15,0,12" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel x:Name="FileArea">
       <StackPanel x:Name="InlineMedia" Visibility="Collapsed" Margin="0,0,0,18">
        <DockPanel Margin="0,0,0,10">
         <Button DockPanel.Dock="Right" Content="⛶  To‘liq ekran" Click="OpenInlineVideoFullscreen"
                 Background="#214744" Foreground="#99F6E4"/>
         <ComboBox x:Name="InlineVideoSelection" MinWidth="130" HorizontalAlignment="Left" Padding="9,5"
                   SelectionChanged="SelectInlineVideo" AutomationProperties.Name="Videoni tanlash"/>
        </DockPanel>
        <local:InternalViewer x:Name="InlineViewer" Height="490"/>
       </StackPanel>
       <TextBlock Text="Mavzu fayllari" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
       <Border x:Name="FileEmpty" Background="#131F32" BorderBrush="#30445A" BorderThickness="1" CornerRadius="16" Padding="36"><StackPanel HorizontalAlignment="Center"><TextBlock Text="▤" FontSize="42" Foreground="#5D8597" HorizontalAlignment="Center"/><TextBlock Text="Hali material yuklanmagan" FontSize="22" Margin="0,15,0,8" TextAlignment="Center"/><TextBlock Text="Materiallar tayyor bo‘lgach, shu yerda ko‘rinadi." Foreground="#93A4BA" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
       <ItemsControl x:Name="ResourceFiles">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Background="#C9152238" BorderBrush="{Binding Accent}" BorderThickness="2,0,0,0"
                  CornerRadius="13" Padding="18" Margin="0,0,0,12">
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" Background="#B80E1828" CornerRadius="12" VerticalAlignment="Top" Margin="0,0,14,0">
             <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{Binding Accent}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="0,0,14,0">
             <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
             <WrapPanel Margin="0,6,0,4">
              <Border Background="#B80E1828" CornerRadius="6" Padding="7,2" Margin="0,0,9,0">
               <TextBlock Text="{Binding Format}" Foreground="{Binding Accent}" FontSize="12" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="{Binding SizeLabel}" Foreground="#D1DFEC" FontSize="13" VerticalAlignment="Center"/>
             </WrapPanel>
             <TextBlock Text="{Binding Description}" Foreground="#D1DFEC" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Ochish →" Tag="{Binding Path}" Click="OpenResourceFile"
                    Background="#214744" Foreground="#99F6E4" VerticalAlignment="Center"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <StackPanel x:Name="MethodPanel" Visibility="Collapsed"/>
      <StackPanel x:Name="TextArea">
       <TextBlock x:Name="TextAreaTitle" Text="O‘quv materiali" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,15"/>
       <StackPanel x:Name="GlossaryContainer" Visibility="Collapsed" Margin="0,0,0,16"/>
       <Border x:Name="PreviewArea" Background="#F8FAFC" CornerRadius="12" Padding="28" MinHeight="300"><TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="#172033" FontFamily="Calibri" FontSize="18.667"/></Border>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="SectionPanel" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Stretch">
      <Button x:Name="TopicsBackButton" Tag="topics" Click="Navigate" Foreground="#5EEAD4" Padding="0,8" Content="←  Mavzularga qaytish" HorizontalAlignment="Left" Visibility="Collapsed"/>
      <Button Tag="home" Click="Navigate" Foreground="#5EEAD4" Padding="0,8" Content="←  Bosh sahifaga qaytish" HorizontalAlignment="Left"/>
      <TextBlock x:Name="SectionTitle" FontSize="32" FontWeight="Bold" Margin="0,22,0,12"/>
      <TextBlock x:Name="SectionDescription" FontSize="14" Foreground="#93A4BA" TextWrapping="Wrap" LineHeight="25"/>
      <Border x:Name="SectionOverview" Margin="0,28,0,0" Background="#152238" CornerRadius="16" BorderBrush="#294359" BorderThickness="1" Padding="28"><StackPanel>
       <TextBlock x:Name="SectionIcon" Text="▤" Foreground="#5EEAD4" FontSize="36"/>
       <TextBlock x:Name="SectionStatus" Text="Materiallar hali yuklanmagan" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,10"/>
       <TextBlock x:Name="SectionBody" TextWrapping="Wrap" Foreground="#BAC8D9" FontSize="14" LineHeight="26"/>
      </StackPanel></Border>
      <StackPanel x:Name="SectionContent" Margin="0,18,0,0"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
   <Grid x:Name="LectureReader" Grid.Column="1" Panel.ZIndex="12" Visibility="Collapsed" Margin="24,90,24,18" Background="#0B1220">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="ReaderToolbar" Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="ReaderBack" Click="LeaveReader" Content="←  Mavzu resurslari" Foreground="#5EEAD4" Padding="0,8,20,8"/>
     <TextBlock x:Name="LectureCaption" Grid.Column="1" Text="Ma’ruza" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,18,0"/>
     <ComboBox x:Name="LectureFiles" Grid.Column="2" DisplayMemberPath="Name" SelectionChanged="SelectLectureFile" MinWidth="180" MaxWidth="330" Padding="8" AutomationProperties.Name="Material faylini tanlash"/>
     <Button x:Name="ProjectionButton" Grid.Column="3" Click="ToggleProjection" Content="⛶  To‘liq ekran · F11"
             Margin="10,0,0,0" Background="#214744" Foreground="#99F6E4" Padding="12,8"/>
     <StackPanel x:Name="LectureZoom" Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
      <Button Content="A−" Click="ChangeLectureZoom" Tag="-" AutomationProperties.Name="Matnni kichraytirish" Padding="10,8"/>
      <Button x:Name="ZoomReset" Content="100%" Click="ChangeLectureZoom" Tag="reset" AutomationProperties.Name="Asl o‘lchamga qaytarish" Padding="10,8"/>
      <Button Content="A+" Click="ChangeLectureZoom" Tag="+" AutomationProperties.Name="Matnni kattalashtirish" Padding="10,8"/>
     </StackPanel>
    </Grid>
    <local:InternalViewer x:Name="LectureViewer" Grid.Row="1"/>
   </Grid>
  <local:MediAssistant x:Name="Medi" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18" Panel.ZIndex="10"/>
  <Grid x:Name="MediWelcomeArea" Grid.Column="1" Panel.ZIndex="11" Visibility="Collapsed">
   <Border x:Name="MediWelcome" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
           Margin="0,0,0,354" Padding="20" Background="#182B40" BorderBrush="#4A8883" BorderThickness="1" CornerRadius="18">
    <StackPanel>
     <TextBlock x:Name="MediMessage" Text="Salom! Yangi bilimlarni o‘rganishga tayyormisiz?" TextWrapping="Wrap"
                FontSize="19" FontWeight="SemiBold" Foreground="#F1F5F9"/>
     <Button x:Name="MediMessageButton" Click="DismissMediWelcome" Content="Unda boshladik! →" HorizontalAlignment="Left"
             Foreground="#99F6E4" Background="#214744" Margin="0,10,0,0" Padding="12,8"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
